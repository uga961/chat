# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini Model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Application Access Key (passphrase to unlock the assistant)
APP_ACCESS_KEY=admin123

# Session Secret (Optional: automatically derived from APP_ACCESS_KEY if not specified)
SESSION_SECRET=

# Server configuration
PORT=3000
HOST=0.0.0.0

# Optional: Base URL or domain
NEXT_PUBLIC_APP_URL=https://tredence.ugandhar.in

# Optional: Turso Cloud Database URL and Token (Only required on Vercel for permanent serverless persistence)
# Free hosted SQLite database from https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
