# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini Model to use (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro)
# Default if unset: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Application Access Key (used on the login screen to authenticate users)
APP_ACCESS_KEY=

# Session Secret (random 32+ character string used to sign JWT cookies)
SESSION_SECRET=

# Optional: Host and Port configuration (default: 0.0.0.0:3000)
PORT=3000
HOST=0.0.0.0

# Optional: Base URL or domain
NEXT_PUBLIC_APP_URL=https://tredence.ugandhar.in
